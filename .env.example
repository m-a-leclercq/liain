# Elasticsearch connection
ES_HOST=https://my-cluster.es.io:9243

# Authentication – use one of the two options below:

# Option A – API key (preferred)
ES_API_KEY=your_api_key_here

# Option B – username / password
# ES_USERNAME=elastic
# ES_PASSWORD=changeme

# Target index / data-stream (default: liain)
# ES_INDEX=liain
